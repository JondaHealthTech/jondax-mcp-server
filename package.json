{
  "name": "@jondax/mcp-server",
  "version": "1.0.1",
  "description": "Model Context Protocol (MCP) Server for JondaX by Jonda Health",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "jondax-mcp-server": "dist/index.js",
    "mcp-server": "dist/index.js",
    "jondax-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
